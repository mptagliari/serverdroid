# Everything the build depends on, pinned. A different value here is a different build: change it on purpose.
# Linux base: the tag v7.2 of the stable tree and the commit it must resolve to.
LINUX_URL=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
LINUX_TAG=v7.2
LINUX_COMMIT=8d3ae59288f1e7d58d76558a6ee96d533bc5019f
# The reference port (Samsung Galaxy A22 5G, same SoC) whose 136 patches are applied first, then this project's mainline/patches/.
A22X_URL=https://gitlab.com/pessdres/a22x-mainline.git
A22X_COMMIT=dad4ee3060b929c3e6c81d6c8e83409f6cff6fea
A22X_PATCHES=136
OWN_PATCHES=26
# The compiler the pinned configuration (mainline/saipan.config) was resolved with.
GCC_EXPECT="aarch64-linux-gnu-gcc (Debian 14.2.0-19) 14.2.0"
# Kernel identity: neutral and fixed, so that two builds of the same sources do not differ in their banner.
KBUILD_BUILD_USER=serverdroid
KBUILD_BUILD_HOST=build
KBUILD_BUILD_TIMESTAMP="Thu Jan  1 00:00:00 UTC 1970"
KBUILD_BUILD_VERSION=1
# Appended to the stock kernel command line of the boot image.
BOOT_EXTRA_CMDLINE="fbcon=font:TER16x32"
# The Alpine minirootfs the initramfs and the root filesystem start from.
ALPINE_FILE=alpine-minirootfs-3.24.3-aarch64.tar.gz
ALPINE_SHA256=4d3f80afaebd447c5591a63a73bde380a149fe8b2d85488cafabb2ff97551f50
# The stock firmware of the supported device (Motorola moto g50 5G, XT2149-1, saipan, build S1RSS32.38-20-9-13), as downloaded by the owner:
# only its boot.img is read (header fields and the stock device tree). Not redistributable by this project; fetch your own copy.
FIRMWARE_SHA256=eeb4f17189d2dda71644b61af2460533d785e9f89b50365663c96a2630ac5e9e
