From 3fd7d0201aa0532df9257c52c46e7804a490a910 Mon Sep 17 00:00:00 2001
From: study <study@example.invalid>
Date: Sat, 24 Oct 2026 19:48:03 -0300
Subject: [PATCH 12/18] arm64: dts: mediatek: saipan: CPU idle states (cpu and
 cluster off) and the SoC system timer

---
 .../dts/mediatek/mt6833-motorola-saipan.dts   | 41 +++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts b/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
index 1fd8dddcd..5e1a353b5 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
@@ -986,3 +986,44 @@ &cpu7 {
 	sram-supply = <&mt6359_vsram_proc1_ldo_reg>;
 };
 
+
+/*
+ * CPU idle (stages M19 and M20): the stock tree already lists the PSCI idle states with their
+ * latencies; only the compatible is changed so that psci-cpuidle accepts them. M19 allowed the
+ * per-CPU state (cpuoff_l / cpuoff_b); M20 adds the cluster state (clusteroff_l / clusteroff_b).
+ * The deeper mcusys state of the stock list is not used. The SoC system timer keeps counting while a
+ * CPU's local timer is stopped by an idle state.
+ */
+&cpuoff_l {
+	compatible = "arm,idle-state";
+};
+
+&cpuoff_b {
+	compatible = "arm,idle-state";
+};
+
+&clusteroff_l {
+	compatible = "arm,idle-state";
+};
+
+&clusteroff_b {
+	compatible = "arm,idle-state";
+};
+
+&{/cpus/cpu@000} { cpu-idle-states = <&cpuoff_l &clusteroff_l>; };
+&{/cpus/cpu@001} { cpu-idle-states = <&cpuoff_l &clusteroff_l>; };
+&{/cpus/cpu@002} { cpu-idle-states = <&cpuoff_l &clusteroff_l>; };
+&{/cpus/cpu@003} { cpu-idle-states = <&cpuoff_l &clusteroff_l>; };
+&{/cpus/cpu@004} { cpu-idle-states = <&cpuoff_l &clusteroff_l>; };
+&{/cpus/cpu@005} { cpu-idle-states = <&cpuoff_l &clusteroff_l>; };
+&{/cpus/cpu@100} { cpu-idle-states = <&cpuoff_b &clusteroff_b>; };
+&{/cpus/cpu@101} { cpu-idle-states = <&cpuoff_b &clusteroff_b>; };
+
+/ {
+	timer@10017000 {
+		compatible = "mediatek,mt6833-timer", "mediatek,mt6765-timer";
+		reg = <0 0x10017000 0 0x1000>;
+		interrupts = <0 233 4>;
+		clocks = <&clk13m>;
+	};
+};
-- 
