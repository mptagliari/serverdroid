From ecd1cf6f530db344cb636cfeda850f06b24b7e15 Mon Sep 17 00:00:00 2001
From: study <study@example.invalid>
Date: Sat, 24 Oct 2026 13:50:35 -0300
Subject: [PATCH 02/18] clk: mediatek: mt6833: register the infracfg_ao UFS
 reset controller

The downstream UFS platform code writes these SET/CLR pairs directly.
---
 drivers/clk/mediatek/clk-mt6833.c         | 30 +++++++++++++++++++++++
 include/dt-bindings/reset/mt6833-resets.h | 12 +++++++++
 2 files changed, 42 insertions(+)
 create mode 100644 include/dt-bindings/reset/mt6833-resets.h

diff --git a/drivers/clk/mediatek/clk-mt6833.c b/drivers/clk/mediatek/clk-mt6833.c
index d3da11322..a05512004 100644
--- a/drivers/clk/mediatek/clk-mt6833.c
+++ b/drivers/clk/mediatek/clk-mt6833.c
@@ -7,6 +7,7 @@
  */
 
 #include <dt-bindings/clock/mt6833-clk.h>
+#include <dt-bindings/reset/mt6833-resets.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -14,6 +15,7 @@
 #include "clk-gate.h"
 #include "clk-mtk.h"
 #include "clk-mux.h"
+#include "reset.h"
 
 static DEFINE_SPINLOCK(mt6833_clk_lock);
 
@@ -1430,9 +1432,37 @@ static const struct mtk_clk_desc topck_desc = {
 	.mfg_clk_idx = CLK_TOP_MFG_PLL_SEL,
 };
 
+/*
+ * UFS host resets: set/clr register pairs in infracfg_ao that the downstream UFS platform code
+ * writes directly (ufs-mtk-platform.h: HCI 0x130/0x134 bit 15, UniPro 0x140/0x144 bit 7, M-PHY
+ * 0x140/0x144 bit 9, crypto 0x150/0x154 bit 21).
+ */
+static u16 ifrao_rst_ofs[] = {
+	INFRA_RST0_SET_OFFSET,
+	INFRA_RST1_SET_OFFSET,
+	INFRA_RST2_SET_OFFSET,
+	INFRA_RST3_SET_OFFSET,
+};
+
+static u16 ifrao_rst_idx_map[] = {
+	[MT6833_INFRA_RST1_UFSHCI_SWRST] = 1 * RST_NR_PER_BANK + 15,
+	[MT6833_INFRA_RST2_UNIPRO_SWRST] = 2 * RST_NR_PER_BANK + 7,
+	[MT6833_INFRA_RST2_UFSPHY_SWRST] = 2 * RST_NR_PER_BANK + 9,
+	[MT6833_INFRA_RST3_UFSCPT_SWRST] = 3 * RST_NR_PER_BANK + 21,
+};
+
+static const struct mtk_clk_rst_desc ifrao_rst_desc = {
+	.version = MTK_RST_SET_CLR,
+	.rst_bank_ofs = ifrao_rst_ofs,
+	.rst_bank_nr = ARRAY_SIZE(ifrao_rst_ofs),
+	.rst_idx_map = ifrao_rst_idx_map,
+	.rst_idx_map_nr = ARRAY_SIZE(ifrao_rst_idx_map),
+};
+
 static const struct mtk_clk_desc ifrao_desc = {
 	.clks = ifrao_clks,
 	.num_clks = ARRAY_SIZE(ifrao_clks),
+	.rst_desc = &ifrao_rst_desc,
 };
 
 static const struct of_device_id of_match_clk_mt6833[] = {
diff --git a/include/dt-bindings/reset/mt6833-resets.h b/include/dt-bindings/reset/mt6833-resets.h
new file mode 100644
index 000000000..30ee2ffee
--- /dev/null
+++ b/include/dt-bindings/reset/mt6833-resets.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+
+#ifndef _DT_BINDINGS_RESET_CONTROLLER_MT6833
+#define _DT_BINDINGS_RESET_CONTROLLER_MT6833
+
+/* INFRA resets (infracfg_ao set/clr banks 0x130, 0x140, 0x150) */
+#define MT6833_INFRA_RST1_UFSHCI_SWRST		0
+#define MT6833_INFRA_RST2_UNIPRO_SWRST		1
+#define MT6833_INFRA_RST2_UFSPHY_SWRST		2
+#define MT6833_INFRA_RST3_UFSCPT_SWRST		3
+
+#endif  /* _DT_BINDINGS_RESET_CONTROLLER_MT6833 */
-- 
2.47.3

