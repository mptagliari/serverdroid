From b43b92100b9ede292886dc95a7a78f49e902496b Mon Sep 17 00:00:00 2001
From: Matheus Tagliari <160161347+mptagliari@users.noreply.github.com>
Date: Sun, 25 Oct 2026 19:23:19 -0300
Subject: [PATCH] arm64: dts: mediatek: saipan: vibration motor (VIBR LDO as a
 regulator-haptic)

---
 .../boot/dts/mediatek/mt6833-motorola-saipan.dts   | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts b/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
index abb7b2de5..4ab35cb58 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
@@ -137,6 +137,13 @@ watchdog@10007000 {
 		reg = <0 0x10007000 0 0x100>;
 		#reset-cells = <1>;
 	};
+	/* Vibration motor as a force-feedback input device (rumble effect) */
+	haptic {
+		compatible = "regulator-haptic";
+		haptic-supply = <&mt6359_vibr_ldo_reg>;
+		min-microvolt = <2800000>;
+		max-microvolt = <3000000>;
+	};
 };
 
 &apuart0 {
@@ -1144,6 +1151,13 @@ power-domain@MT6833_POWER_DOMAIN_CONN {
 
 &mt6359 {
 	regulators {
+		/* Vibration motor supply: the stock tree's "mediatek,vibrator" (vib_vol 9) is this LDO driving an eccentric motor. */
+		mt6359_vibr_ldo_reg: ldo_vibr {
+			regulator-name = "vibr";
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <3000000>;
+		};
+
 		mt6359_vcn18_ldo_reg: ldo_vcn18 {
 			regulator-name = "vcn18";
 			regulator-min-microvolt = <1800000>;
-- 
2.47.3

