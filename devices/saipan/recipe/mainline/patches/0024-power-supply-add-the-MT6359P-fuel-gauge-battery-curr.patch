From 83a947ce804794f3bce918776c497a6d97c67f94 Mon Sep 17 00:00:00 2001
From: Matheus Tagliari <160161347+mptagliari@users.noreply.github.com>
Date: Sun, 25 Oct 2026 20:25:21 -0300
Subject: [PATCH] power: supply: add the MT6359P fuel gauge (battery current
 and charge counter)

Expose the FGADC block of the MT6359P as a power supply, read with the
vendor's latch handshake (SW_READ_PRE, LATCHDATA_ST, SW_CLEAR). Instantiated
as an MFD cell from the PMIC node (mediatek,mt6359-fg).
---
 .../dts/mediatek/mt6833-motorola-saipan.dts   |   5 +
 drivers/mfd/mt6397-core.c                     |   4 +
 drivers/power/supply/Kconfig                  |   7 +
 drivers/power/supply/Makefile                 |   1 +
 drivers/power/supply/mt6359_fg.c              | 150 ++++++++++++++++++
 5 files changed, 167 insertions(+)
 create mode 100644 drivers/power/supply/mt6359_fg.c

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts b/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
index 5e371e769..e6f002ae3 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
@@ -1155,6 +1155,11 @@ pmic_adc: adc {
 		compatible = "mediatek,mt6359-auxadc";
 		#io-channel-cells = <1>;
 	};
+
+	/* Fuel gauge block (FGADC): battery current and charge counter */
+	fuel-gauge {
+		compatible = "mediatek,mt6359-fg";
+	};
 };
 
 &mt6359 {
