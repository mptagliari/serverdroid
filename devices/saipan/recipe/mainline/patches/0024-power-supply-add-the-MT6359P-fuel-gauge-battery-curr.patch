diff --git a/drivers/power/supply/mt6359_fg.c b/drivers/power/supply/mt6359_fg.c
new file mode 100644
index 000000000..d94c67e76
--- /dev/null
+++ b/drivers/power/supply/mt6359_fg.c
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT6359P fuel gauge: battery current and charge counter as a power supply.
+ *
+ * The coulomb counter (CAR) and the battery current live in a latched copy of the FGADC block: set SW_READ_PRE, wait for LATCHDATA_ST, read,
+ * set SW_CLEAR, clear SW_READ_PRE, wait for LATCHDATA_ST to drop, clear SW_CLEAR (the vendor sequence of mt6359_gauge.c). Reading the
+ * registers without it returns a stale copy. The gauge runs from reset; this driver only reads it. The battery voltage and temperature come
+ * from the AUXADC (mt6359-auxadc), and the state of charge is an estimate left to user space.
+ *
+ * Scales (checked against the vendor kernel and, while charging, against the MT6360 battery-current ADC): 0.610352 mA per count of the
+ * current register and 0.085 uAh per count of CAR, both times the vendor's CAR_TUNE of 0.99.
+ */
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/math64.h>
+#include <linux/mfd/mt6397/core.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+
+#define MT6359_FGADC_CON1	0xd0a
+#define  FG_SW_READ_PRE		BIT(0)
+#define  FG_SW_CLEAR		BIT(3)
+#define  FG_LATCHDATA_ST	BIT(15)
+#define MT6359_FGADC_CAR_CON0	0xd16	/* CAR[15:0] */
+#define MT6359_FGADC_CAR_CON1	0xd18	/* CAR[31:16] */
+#define MT6359_FGADC_CUR_CON0	0xd8a	/* signed 16 bit, positive = charging */
+
+#define FG_LATCH_TRIES		1000
+
+struct mt6359_fg {
+	struct regmap *regmap;
+	struct mutex lock;	/* the latch handshake is not reentrant */
+};
+
+static int mt6359_fg_wait_latch(struct mt6359_fg *fg, bool set)
+{
+	unsigned int val;
+	int i, ret;
+
+	for (i = 0; i < FG_LATCH_TRIES; i++) {
+		ret = regmap_read(fg->regmap, MT6359_FGADC_CON1, &val);
+		if (ret)
+			return ret;
+		if (!!(val & FG_LATCHDATA_ST) == set)
+			return 0;
+		usleep_range(50, 100);
+	}
+	return -ETIMEDOUT;
+}
+
+/* One latched snapshot: the current register (s16) and the coulomb counter (s32). */
+static int mt6359_fg_snapshot(struct mt6359_fg *fg, int *cur_raw, s32 *car_raw)
+{
+	unsigned int cur, lo, hi;
+	int ret, ret2;
+
+	regmap_update_bits(fg->regmap, MT6359_FGADC_CON1, FG_SW_READ_PRE, FG_SW_READ_PRE);
+	ret = mt6359_fg_wait_latch(fg, true);
+	if (!ret) {
+		regmap_read(fg->regmap, MT6359_FGADC_CUR_CON0, &cur);
+		regmap_read(fg->regmap, MT6359_FGADC_CAR_CON0, &lo);
+		regmap_read(fg->regmap, MT6359_FGADC_CAR_CON1, &hi);
+		*cur_raw = (s16)cur;
+		*car_raw = (s32)((hi << 16) | (lo & 0xffff));
+	}
+	regmap_update_bits(fg->regmap, MT6359_FGADC_CON1, FG_SW_CLEAR, FG_SW_CLEAR);
+	regmap_update_bits(fg->regmap, MT6359_FGADC_CON1, FG_SW_READ_PRE, 0);
+	ret2 = mt6359_fg_wait_latch(fg, false);
+	regmap_update_bits(fg->regmap, MT6359_FGADC_CON1, FG_SW_CLEAR, 0);
+	return ret ?: ret2;
+}
+
+static int mt6359_fg_get_property(struct power_supply *psy, enum power_supply_property psp,
+				  union power_supply_propval *val)
+{
+	struct mt6359_fg *fg = power_supply_get_drvdata(psy);
+	int cur, ret;
+	s32 car;
+
+	mutex_lock(&fg->lock);
+	ret = mt6359_fg_snapshot(fg, &cur, &car);
+	mutex_unlock(&fg->lock);
+	if (ret)
+		return ret;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CURRENT_NOW:	/* uA, negative while discharging */
+		val->intval = div_s64((s64)cur * 610352 * 99, 100000);
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_COUNTER:	/* uAh since the counter was last reset */
+		val->intval = div_s64((s64)car * 85 * 99, 100 * 1000);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const enum power_supply_property mt6359_fg_props[] = {
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_CHARGE_COUNTER,
+};
+
+static const struct power_supply_desc mt6359_fg_desc = {
+	.name = "mt6359-fg",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = mt6359_fg_props,
+	.num_properties = ARRAY_SIZE(mt6359_fg_props),
+	.get_property = mt6359_fg_get_property,
+};
+
+static int mt6359_fg_probe(struct platform_device *pdev)
+{
+	struct power_supply_config cfg = {};
+	struct power_supply *psy;
+	struct mt6397_chip *chip = dev_get_drvdata(pdev->dev.parent);
+	struct mt6359_fg *fg;
+
+	fg = devm_kzalloc(&pdev->dev, sizeof(*fg), GFP_KERNEL);
+	if (!fg)
+		return -ENOMEM;
+	fg->regmap = chip->regmap;
+	devm_mutex_init(&pdev->dev, &fg->lock);
+
+	cfg.drv_data = fg;
+	cfg.fwnode = dev_fwnode(&pdev->dev);
+	psy = devm_power_supply_register(&pdev->dev, &mt6359_fg_desc, &cfg);
+	return PTR_ERR_OR_ZERO(psy);
+}
+
+static const struct of_device_id mt6359_fg_of_match[] = {
+	{ .compatible = "mediatek,mt6359-fg" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6359_fg_of_match);
+
+static struct platform_driver mt6359_fg_driver = {
+	.driver = {
+		.name = "mt6359-fg",
+		.of_match_table = mt6359_fg_of_match,
+	},
+	.probe = mt6359_fg_probe,
+};
+module_platform_driver(mt6359_fg_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6359P fuel gauge (battery current and charge counter)");
+MODULE_LICENSE("GPL");
-- 
