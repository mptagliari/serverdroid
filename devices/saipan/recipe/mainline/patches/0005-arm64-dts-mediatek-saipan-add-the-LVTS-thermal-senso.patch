From e3acfac2563e5658de8405bc5320d8d8bed83388 Mon Sep 17 00:00:00 2001
From: study <study@example.invalid>
Date: Sat, 24 Oct 2026 16:17:31 -0300
Subject: [PATCH 05/18] arm64: dts: mediatek: saipan: add the LVTS thermal
 sensors and zones

---
 .../dts/mediatek/mt6833-motorola-saipan.dts   | 137 ++++++++++++++++++
 1 file changed, 137 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts b/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
index 1393bd95f..0bdc5f0cd 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
@@ -21,6 +21,8 @@
 #include <dt-bindings/pinctrl/mt6833-pinfunc.h>
 #include <dt-bindings/pinctrl/mt65xx.h>
 #include <dt-bindings/reset/mt6833-resets.h>
+#include <dt-bindings/thermal/mediatek,lvts-thermal.h>
+#include <dt-bindings/thermal/thermal.h>
 #include "mt6833-motorola-saipan-lk-compat.dtsi"
 
 / {
@@ -298,3 +300,138 @@ &ufshci {
 	vccq2-supply = <&reg_vufs>;
 	mediatek,ufs-disable-mcq;
 };
+
+/*
+ * Thermal (stage M5): LVTS sensors and trip points copied from the a22x file (same SoC; the
+ * sensor ids and the calibration cell are SoC-level). The trip temperatures are the a22x ones, not
+ * checked against the Motorola values. No cooling maps yet: they need the CPU frequency scaling,
+ * which needs the PMIC regulators. The 117 C critical trips still power the phone off.
+ */
+/ {
+	efuse_ml: efuse@11c10000 {
+		compatible = "mediatek,mt6833-efuse", "mediatek,efuse";
+		reg = <0 0x11c10000 0 0x1000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		lvts_e_data1: data1@1c0 {
+			reg = <0x1c0 0x58>;
+		};
+	};
+
+	lvts: thermal-sensor@1100b000 {
+		compatible = "mediatek,mt6833-lvts-ap";
+		reg = <0 0x1100b000 0 0xc00>;
+		interrupts = <0 169 4>;
+		clocks = <&infracfg_ao CLK_IFRAO_THERM>;
+		nvmem-cells = <&lvts_e_data1>;
+		nvmem-cell-names = "lvts-calib-data-1";
+		#thermal-sensor-cells = <1>;
+	};
+
+	thermal-zones {
+		cpu-little-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <1000>;
+			thermal-sensors = <&lvts MT6833_AP_LITTLE1>;
+
+			trips {
+				little_alert: trip-alert {
+					temperature = <85000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				little_hot: trip-hot {
+					temperature = <95000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				little_crit: trip-crit {
+					temperature = <117000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+
+		cpu-big-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <1000>;
+			thermal-sensors = <&lvts MT6833_AP_BIG1>;
+
+			trips {
+				big_alert: trip-alert {
+					temperature = <85000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				big_hot: trip-hot {
+					temperature = <95000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				big_crit: trip-crit {
+					temperature = <117000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+
+		gpu-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <1000>;
+			thermal-sensors = <&lvts MT6833_AP_GPU1>;
+
+			trips {
+				gpu_alert: trip-alert {
+					temperature = <85000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				gpu_hot: trip-hot {
+					temperature = <95000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				gpu_crit: trip-crit {
+					temperature = <117000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+
+		soc-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <1000>;
+			thermal-sensors = <&lvts MT6833_AP_SOC>;
+
+			trips {
+				soc_alert: trip-alert {
+					temperature = <85000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				soc_hot: trip-hot {
+					temperature = <95000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				soc_crit: trip-crit {
+					temperature = <117000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+	};
+};
-- 
