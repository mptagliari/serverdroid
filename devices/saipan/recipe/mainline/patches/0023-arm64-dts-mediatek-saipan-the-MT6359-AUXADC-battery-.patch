From be5ee42b6f70214525c3231f18848907e9af1501 Mon Sep 17 00:00:00 2001
From: Matheus Tagliari <160161347+mptagliari@users.noreply.github.com>
Date: Sun, 25 Oct 2026 20:12:38 -0300
Subject: [PATCH] arm64: dts: mediatek: saipan: the MT6359 AUXADC (battery
 voltage, current and thermistor)

---
 arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts b/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
index 4ab35cb58..5e371e769 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-motorola-saipan.dts
@@ -1149,6 +1149,14 @@ power-domain@MT6833_POWER_DOMAIN_CONN {
 	};
 };
 
+&mt6359 {
+	/* PMIC auxiliary ADC: battery voltage (batt_v), battery current (batt_i), battery thermistor (batt_temp), chip temperature */
+	pmic_adc: adc {
+		compatible = "mediatek,mt6359-auxadc";
+		#io-channel-cells = <1>;
+	};
+};
+
 &mt6359 {
 	regulators {
 		/* Vibration motor supply: the stock tree's "mediatek,vibrator" (vib_vol 9) is this LDO driving an eccentric motor. */
-- 
2.47.3

